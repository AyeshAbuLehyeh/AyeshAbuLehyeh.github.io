{% assign repo_url = include.repository | split: '/' %}

<div class="repo p-3 border rounded m-2" style="min-width:260px; max-width:360px;">
  <h5 class="mb-1">
    <a href="https://github.com/{{ include.repository }}" target="_blank">
      {{ repo_url[1] }}
    </a>
  </h5>

  <p class="mb-1 text-muted" style="font-size: 0.9rem;">
    {{ repo_url[0] }}
  </p>

  <p class="mb-0" style="font-size: 0.9rem;">
    View source code and documentation on GitHub.
  </p>
</div>
